<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    
     <bean name="add1" class="seekho.spring.model.Address">
     <property name="city" value="budaun"/>
     <property name="state" value="UP"/>
      </bean>
    
    
   <bean name="emp1" class="seekho.spring.model.Employee">
      <property name="id" value="120"/>
      <property name="name" value="Jasvant"/>
      <property name="gender" value="male"/>
      <property name="address" ref="add1"/> 
   </bean>
   
   <bean name="add2" class="seekho.spring.model.Address">
     <constructor-arg name="city" value="Bareilly"/>
     <constructor-arg   name="state" value="UP"/>
      </bean>
   
   <bean name="emp2" class="seekho.spring.model.Employee">
   
   <constructor-arg name="id" value="124"/>
   <constructor-arg name="name" value="Rekha"/>
   <constructor-arg name="gendar" value="female"/>
   <constructor-arg name="address" ref="add2"/>
   
   </bean>
   

</beans>