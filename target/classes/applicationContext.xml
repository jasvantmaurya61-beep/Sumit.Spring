<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    
     <bean name="add1" class="seekho.spring.model.Address">
     <property name="city" value="budaun"/>
     <property name="state" value="UP"/>
      </bean>
    
    
   <bean name="emp1" class="seekho.spring.model.Employee">
      <property name="id" value="120"/>
      <property name="name" value="Jasvant"/>
      <property name="gender" value="male"/>
      <property name="address" ref="add1"/> 
      
      <property name="list">
            <list>
            <value>110</value>
            <value>111</value>
            <value>112</value>
            <value>113</value>
            <value>114</value>
            <value>115</value>
            <value>110</value>
            <value>111</value>
            </list>
     </property>
     <property name="set">
              <set>
              <value>10</value>
              <value>11</value>
              <value>12</value>
              <value>13</value>
              <value>14</value>
              <value>10</value>
              <value>11</value>
              <value>15</value>
              </set>
       </property>
       <property name="map">
              <map>
              <entry key="1" value="ONE"/>
              <entry key="2" value="TWO"/>
              <entry key="3" value="THREE"/>
              <entry key="4" value="FOUR"/>
              <entry key="2" value="two"/>
              <entry key="1" value="one"/>
              </map>
       </property>
   </bean>
   
